<script>
const G={7:"هفتم",8:"هشتم",9:"نهم"};
const C={
7:[["راهبردهای حل مسئله","الگو بساز، جدول بکش، حدس بزن و بررسی کن.","جملهٔ n‌ام: a+(n−1)d",["seq"]],
["عددهای صحیح","دمای قله −۵ بود و ۸ درجه گرم شد؛ جمع و تفریق روی محور.","a−(−b)=a+b",["int","imul"]],

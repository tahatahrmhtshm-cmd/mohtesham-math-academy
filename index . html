["آمار و احتمال","میانگین نقطهٔ تعادل داده‌هاست.","احتمال = مطلوب ÷ کل",["mean","prob"]]],
8:[["عددهای صحیح و گویا","کسرها و درصدها را روی محور بشناس.","a% از N = N×a÷۱۰۰",["int","imul","pct"]],
["عددهای اول","هر عدد را به اول‌ها بشکن.","ب.م.م و ک.م.م از تجزیه",["gcd","lcm","prime"]],
["چندضلعی‌ها","از یک رأس قطر بکش تا مثلث بسازی.","مجموع زوایا (n−۲)×۱۸۰ · قطر n(n−۳)/۲",["poly","diag","regang"]],
["عبارت‌های جبری","زمین مربعی به ضلع a+b را تکه‌تکه کن.","(a+b)²=a²+2ab+b²",["expand","lin"]],
["خط و معادله","شیب یعنی تندیِ بالا رفتن.","شیب = Δy ÷ Δx",["slope","line"]],
["مثلث","وتر، مثلث قائم‌الزاویه را می‌سازد.","فیثاغورس a²+b²=c²",["tri","pyth"]],
["توان و جذر","ضرب تکراری و ریشهٔ کامل.","(a^m)^n = a^(mn)",["pow","sqrt"]],
["بردار و مختصات","وسط دو نقطه را از میانگین مختصات بگیر.","وسط: ((x₁+x₂)/۲, (y₁+y₂)/۲)",["move","mid"]],
